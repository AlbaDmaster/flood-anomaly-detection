DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flood_anomaly_detection
DB_USER=flood_app
DB_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# Optional: email HIGH alerts to responders, authorities and administrators.
# Leave MAIL_SERVER empty to print the emails in the terminal instead.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) below.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Link put in alert emails
APP_URL=http://127.0.0.1:5000
